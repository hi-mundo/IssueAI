{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["document_type", "schema_version", "corpora", "inventory", "coverage", "quality_gaps", "policy"],
  "properties": {
    "document_type": {"const": "bug-hunt.corpus-manifest"},
    "schema_version": {"const": "1.0"},
    "corpora": {"type": "array", "minItems": 1},
    "inventory": {"type": "object", "required": ["records", "unique_urls", "duplicate_urls", "repositories"]},
    "coverage": {"type": "object", "required": ["complexity_tier", "validation_status", "mechanism_families", "mechanism_subtypes", "conditions", "surfaces"]},
    "quality_gaps": {"type": "object"},
    "policy": {"type": "object", "required": ["source_evidence_is_not_confirmation", "unvalidated_cases_must_not_be_reported", "duplicate_urls_must_be_zero"]}
  }
}
