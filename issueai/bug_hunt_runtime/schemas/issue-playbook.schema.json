{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "surface",
    "trigger",
    "expected_invariant",
    "broken_transition",
    "broken_control",
    "concrete_instance",
    "false_sense_of_safety",
    "where_to_look",
    "how_to_compare",
    "probe_shape",
    "playbook_family",
    "playbook_signature"
  ],
  "properties": {
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "trigger": {
      "type": "string",
      "minLength": 1
    },
    "expected_invariant": {
      "type": "string",
      "minLength": 1
    },
    "broken_transition": {
      "type": "string",
      "minLength": 1
    },
    "broken_control": {
      "type": "string",
      "minLength": 1
    },
    "concrete_instance": {
      "type": "string",
      "minLength": 1
    },
    "false_sense_of_safety": {
      "type": "string",
      "minLength": 1
    },
    "where_to_look": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "how_to_compare": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "probe_shape": {
      "type": "string",
      "minLength": 1
    },
    "playbook_family": {
      "type": "string",
      "minLength": 1
    },
    "playbook_signature": {
      "type": "string",
      "minLength": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
