{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "documentType",
    "reviewId",
    "mode",
    "inventoryStrategy",
    "status",
    "surfaces"
  ],
  "properties": {
    "documentType": {
      "const": "bug-hunt.coverage"
    },
    "reviewId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "normal",
        "deep"
      ]
    },
    "inventoryStrategy": {
      "type": "string",
      "enum": [
        "repository",
        "scoped_path",
        "custom"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "unknown"
      ]
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "family",
          "disposition"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "reportable",
              "suppressed",
              "not_applicable",
              "deferred"
            ]
          },
          "candidateIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
